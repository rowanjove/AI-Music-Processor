{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ai-music-processor/components.schema.json",
  "title": "Declarative component catalog",
  "type": "object",
  "required": ["schema_version", "catalog_kind", "size_policy", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_kind": { "const": "installed-workspace-description" },
    "size_policy": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "id", "name", "kind", "ownership", "required", "implemented",
        "capabilities", "modes", "dependencies", "probes",
        "license_status", "distribution_status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["application", "runtime", "tool", "engine", "model", "model_scan", "mode_pack"]
        },
        "ownership": { "enum": ["managed", "user", "external"] },
        "required": { "type": "boolean" },
        "implemented": { "type": "boolean" },
        "version": { "type": ["string", "null"] },
        "version_evidence": { "type": "string" },
        "version_probe": { "$ref": "#/$defs/version_probe" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" }
        },
        "modes": {
          "type": "array",
          "items": { "enum": ["polish", "voice_conversion", "transcribe"] }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requires_any": {
          "type": "array",
          "items": { "type": "string" }
        },
        "probes": {
          "type": "array",
          "items": { "$ref": "#/$defs/probe" }
        },
        "details": { "$ref": "#/$defs/details" },
        "unavailable_reason": { "type": "string", "minLength": 1 },
        "license_status": { "const": "UNKNOWN" },
        "distribution_status": { "const": "UNKNOWN" }
      },
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "properties": {
        "f0_methods": { "type": "array", "items": { "type": "string" } },
        "f0_methods_not_implemented": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "minimum_python_version": {
          "type": "array",
          "prefixItems": [ { "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 } ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "version_probe": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["json_keys", "text_file", "path_exists"] },
        "file": { "type": "string" },
        "keys": { "type": "array", "items": { "type": "string" } },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["relative_file", "relative_dir", "tool", "user_rvc_models"] },
        "path": { "type": "string" },
        "role": { "enum": ["required", "optional"] },
        "name": { "type": "string" },
        "release_path": { "type": "string" },
        "dev_paths": { "type": "array", "items": { "type": "string" } },
        "allow_host_in_dev": { "type": "boolean" },
        "host_before_dev_path_index": { "type": "integer", "minimum": 0 },
        "weights_dir": { "type": "string" },
        "logs_dir": { "type": "string" },
        "user_root": { "type": "string" },
        "managed_files": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
